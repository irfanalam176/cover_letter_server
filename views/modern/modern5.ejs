<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: #111111;
      color: #e5e5e5;
      line-height: 1.7;
      display: flex;
      justify-content: center;
      padding: 40px 20px;
    }
    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #1a1a1a;
      border-radius: 0;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,.6);
    }
    .split-header {
      background: #d97706;
      padding: 36px 48px;
    }
    .split-header h1 {
      font-size: 30px;
      font-weight: 800;
      color: #fff;
      letter-spacing: -.3px;
      margin-bottom: 2px;
    }
    .split-header .tagline {
      font-size: 12px;
      font-weight: 500;
      color: rgba(255,255,255,.7);
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    .body-area {
      padding: 36px 48px 44px;
    }
    .contact-block {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px 24px;
      font-size: 13px;
      color: #a3a3a3;
      margin-bottom: 28px;
      padding-bottom: 20px;
      border-bottom: 1px solid #2a2a2a;
    }
    .contact-block a {
      color: #d97706;
      text-decoration: none;
    }
    .contact-block a:hover { text-decoration: underline; }
    .social-links {
      grid-column: 1 / -1;
      display: flex;
      gap: 8px;
      margin-top: 4px;
    }
    .social-links a {
      font-size: 11px;
      font-weight: 600;
      color: #d97706;
      text-decoration: none;
      padding: 3px 14px;
      border: 1px solid #333;
      border-radius: 4px;
      transition: all .2s;
    }
    .social-links a:hover {
      background: #d97706;
      color: #111;
      border-color: #d97706;
    }
    .date-dear {
      margin-bottom: 24px;
    }
    .date-dear .date {
      font-size: 13px;
      color: #6b7280;
      margin-bottom: 4px;
    }
    .date-dear .dear {
      font-size: 15px;
      font-weight: 600;
      color: #f5f5f5;
    }
    .body-text p {
      font-size: 14px;
      line-height: 1.85;
      color: #d4d4d4;
      margin-bottom: 14px;
    }
    .closing {
      margin-top: 32px;
    }
    .closing .regards {
      font-size: 14px;
      color: #a3a3a3;
      margin-bottom: 2px;
    }
    .closing .name-outro {
      font-size: 18px;
      font-weight: 700;
      color: #d97706;
    }
@page { size: A4; margin: 12mm; }
    @media print {
      body { background: #fff; padding: 0; }
      .page { box-shadow: none; background: #fff; }
      .split-header { background: #d97706; }
      .body-area { padding: 28px 48px; }
      .body-text p, .contact-block { color: #333; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="split-header">
      <h1><%= coverLetter.name %></h1>
      <div class="tagline">Cover Letter</div>
    </div>
    <div class="body-area">
      <div class="contact-block">
        <div><%= coverLetter.address %></div>
        <div><%= coverLetter.email %></div>
        <div><%= coverLetter.phone %></div>
        <% if (coverLetter.socialLinks) { %>
          <div class="social-links"><%- coverLetter.socialLinks %></div>
        <% } %>
      </div>
      <div class="date-dear">
        <div class="date"><%= coverLetter.date %></div>
        <div class="dear"><%= coverLetter.dear %></div>
      </div>
      <div class="body-text">
        <% (coverLetter.textArea || '').split('\n').filter(p => p.trim()).forEach(function(p) { %>
          <p><%= p %></p>
        <% }) %>
      </div>
      <div class="closing">
        <div class="regards">Sincerely,</div>
        <div class="name-outro"><%= coverLetter.name %></div>
      </div>
    </div>
  </div>
</body>
</html>