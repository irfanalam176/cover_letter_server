<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Outfit', sans-serif;
      background: #f8faf7;
      color: #1c1917;
      display: flex;
      justify-content: center;
      padding: 40px 20px;
    }
    .letter-wrapper {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #fff;
      box-shadow: 0 20px 60px rgba(0,0,0,0.04);
      position: relative;
    }
    .ribbon-header {
      background: linear-gradient(135deg, #65a30d 0%, #4d7c0f 100%);
      padding: 0;
      position: relative;
      overflow: hidden;
    }
    .ribbon-header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: repeating-linear-gradient(
        45deg,
        transparent,
        transparent 20px,
        rgba(255,255,255,0.03) 20px,
        rgba(255,255,255,0.03) 40px
      );
    }
    .ribbon-content {
      padding: 44px 56px 36px;
      position: relative;
      z-index: 1;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }
    .ribbon-name {
      font-family: 'Playfair Display', serif;
      font-size: 38px;
      font-weight: 600;
      color: #fff;
      line-height: 1.15;
    }
    .ribbon-sub {
      font-size: 12px;
      color: rgba(255,255,255,0.65);
      text-transform: uppercase;
      letter-spacing: 3px;
      font-weight: 300;
      margin-top: 4px;
    }
    .ribbon-contact {
      text-align: right;
      font-size: 13px;
      color: rgba(255,255,255,0.7);
      line-height: 1.7;
      font-weight: 300;
    }
    .ribbon-contact a {
      color: rgba(255,255,255,0.7);
      text-decoration: none;
      transition: color 0.2s;
    }
    .ribbon-contact a:hover { color: #fff; }
    .ribbon-stripe {
      height: 6px;
      background: repeating-linear-gradient(
        90deg,
        #7c3aed 0px,
        #7c3aed 40px,
        #6d28d9 40px,
        #6d28d9 80px
      );
    }
    .body-content {
      padding: 36px 56px 48px;
    }
    .date-dear {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 2px solid #f1f5f0;
    }
    .date-line {
      font-size: 14px;
      color: #a8a29e;
      font-weight: 300;
    }
    .dear-line {
      font-family: 'Playfair Display', serif;
      font-size: 22px;
      font-style: italic;
      color: #7c3aed;
    }
    .body-content p {
      margin-bottom: 16px;
      font-size: 15px;
      color: #44403c;
      font-weight: 300;
      line-height: 1.8;
    }
    .body-content p:first-of-type::first-letter {
      font-family: 'Playfair Display', serif;
      font-size: 48px;
      font-weight: 600;
      color: #65a30d;
      float: left;
      line-height: 0.85;
      margin-right: 10px;
      margin-top: 4px;
    }
    .social-ribbon {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 32px;
      padding: 16px 24px;
      background: #fafcf8;
      border: 1px solid #e7ede3;
      border-radius: 6px;
    }
    .social-ribbon a {
      font-size: 13px;
      color: #78716c;
      text-decoration: none;
      padding: 4px 16px;
      border: 1px solid #e7ede3;
      border-radius: 20px;
      transition: all 0.2s;
    }
    .social-ribbon a:hover {
      border-color: #65a30d;
      color: #65a30d;
      background: #f0f9eb;
    }
    .signature-row {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-top: 40px;
      padding-top: 20px;
      border-top: 2px solid #f1f5f0;
    }
    .signature-icon {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, #65a30d, #7c3aed);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-family: 'Playfair Display', serif;
      font-size: 20px;
      font-weight: 600;
      flex-shrink: 0;
    }
    .signature-name {
      font-family: 'Playfair Display', serif;
      font-size: 22px;
      color: #1c1917;
    }
    @media (max-width: 768px) {
      .ribbon-content { flex-direction: column; align-items: flex-start; gap: 12px; padding: 32px 24px; }
      .ribbon-contact { text-align: left; }
      .body-content { padding: 28px 24px 36px; }
      .date-dear { flex-direction: column; gap: 4px; }
    }
@page { size: A4; margin: 12mm; }
    @media print {
      body { padding: 0; background: #fff; }
      .letter-wrapper { box-shadow: none; }
      .ribbon-header { background: #65a30d !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>
<body>
  <div class="letter-wrapper">
    <div class="ribbon-header">
      <div class="ribbon-content">
        <div>
          <div class="ribbon-name"><%= coverLetter.name %></div>
          <div class="ribbon-sub">Cover Letter</div>
        </div>
        <div class="ribbon-contact">
          <div><a href="mailto:<%= coverLetter.email %>"><%= coverLetter.email %></a></div>
          <div><a href="tel:<%= coverLetter.phone %>"><%= coverLetter.phone %></a></div>
          <div><%= coverLetter.address %></div>
        </div>
      </div>
    </div>
    <div class="ribbon-stripe"></div>
    <div class="body-content">
      <div class="date-dear">
        <span class="date-line"><%= coverLetter.date %></span>
        <span class="dear-line"><%= coverLetter.dear %></span>
      </div>
      <% var paragraphs = coverLetter.textArea.split('\n').filter(function(p) { return p.trim() !== ''; }); %>
      <% paragraphs.forEach(function(p) { %>
        <p><%= p %></p>
      <% }); %>
      <% if (coverLetter.socialLinks && coverLetter.socialLinks.length) { %>
        <div class="social-ribbon">
          <% coverLetter.socialLinks.forEach(function(link) { %>
            <a href="<%= link.url %>" target="_blank"><%= link.label || link.url %></a>
          <% }); %>
        </div>
      <% } %>
      <div class="signature-row">
        <div class="signature-icon"><%= (coverLetter.name || 'Y')[0] %></div>
        <div class="signature-name"><%= coverLetter.name %></div>
      </div>
    </div>
  </div>
</body>
</html>