<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: #f5f3f0;
      color: #1c1917;
      line-height: 1.7;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 40px 20px;
    }
    .letter-wrapper {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #fff;
      position: relative;
      box-shadow: 0 20px 60px rgba(0,0,0,0.06);
    }
    .diagonal-header {
      position: relative;
      background: linear-gradient(135deg, #4338ca 0%, #3730a3 100%);
      padding: 60px 60px 80px;
      overflow: hidden;
      clip-path: polygon(0 0, 100% 0, 100% 75%, 0 100%);
    }
    .diagonal-header::before {
      content: '';
      position: absolute;
      top: -60px;
      right: -60px;
      width: 240px;
      height: 240px;
      background: radial-gradient(circle, rgba(217, 119, 6, 0.25) 0%, transparent 70%);
      border-radius: 50%;
    }
    .diagonal-header::after {
      content: '';
      position: absolute;
      bottom: 20px;
      left: 40px;
      width: 80px;
      height: 4px;
      background: #d97706;
      border-radius: 2px;
    }
    .header-name {
      font-family: 'DM Serif Display', serif;
      font-size: 42px;
      color: #fff;
      line-height: 1.15;
      position: relative;
      z-index: 1;
    }
    .header-sub {
      font-size: 15px;
      color: rgba(255,255,255,0.7);
      margin-top: 8px;
      font-weight: 300;
      letter-spacing: 0.3px;
      position: relative;
      z-index: 1;
    }
    .body-content {
      padding: 40px 60px 60px;
      position: relative;
    }
    .contact-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 24px 40px;
      background: #fafaf9;
      border: 1px solid #e7e5e4;
      border-radius: 8px;
      padding: 18px 28px;
      margin: -56px 0 36px 0;
      position: relative;
      z-index: 2;
    }
    .contact-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: #44403c;
    }
    .contact-item .icon-dot {
      width: 6px;
      height: 6px;
      background: #d97706;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .contact-item a {
      color: #44403c;
      text-decoration: none;
    }
    .contact-item a:hover { color: #4338ca; }
    .date-line {
      font-size: 14px;
      color: #78716c;
      margin-bottom: 6px;
    }
    .dear-line {
      font-family: 'DM Serif Display', serif;
      font-size: 22px;
      color: #4338ca;
      margin-bottom: 20px;
      font-style: italic;
    }
    .body-content p {
      margin-bottom: 18px;
      font-size: 15px;
      color: #44403c;
      font-weight: 400;
    }
    .body-content p:first-of-type::first-letter {
      font-family: 'DM Serif Display', serif;
      font-size: 52px;
      float: left;
      line-height: 1;
      margin-right: 10px;
      margin-top: 4px;
      color: #d97706;
    }
    .social-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin-top: 36px;
      padding-top: 24px;
      border-top: 2px solid #e7e5e4;
    }
    .social-strip a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: #78716c;
      text-decoration: none;
      padding: 6px 16px;
      border: 1px solid #e7e5e4;
      border-radius: 20px;
      transition: all 0.25s;
    }
    .social-strip a:hover {
      border-color: #4338ca;
      color: #4338ca;
      background: #f5f3ff;
    }
    .signature {
      margin-top: 40px;
      font-family: 'DM Serif Display', serif;
      font-size: 26px;
      color: #4338ca;
    }
    .signature-line {
      width: 80px;
      height: 3px;
      background: #d97706;
      margin-bottom: 12px;
    }
    @media (max-width: 768px) {
      .diagonal-header { padding: 40px 28px 64px; }
      .body-content { padding: 28px 24px 40px; }
      .contact-strip {
        margin: -48px 16px 28px;
        padding: 14px 20px;
      }
      .header-name { font-size: 32px; }
    }
@page { size: A4; margin: 12mm; }
    @media print {
      body { padding: 0; background: #fff; }
      .letter-wrapper { box-shadow: none; }
    }
  </style>
</head>
<body>
  <div class="letter-wrapper">
    <div class="diagonal-header">
      <div class="header-name"><%= coverLetter.name %></div>
      <div class="header-sub">Cover Letter</div>
    </div>
    <div class="body-content">
      <div class="contact-strip">
        <div class="contact-item">
          <span class="icon-dot"></span>
          <a href="mailto:<%= coverLetter.email %>"><%= coverLetter.email %></a>
        </div>
        <div class="contact-item">
          <span class="icon-dot"></span>
          <a href="tel:<%= coverLetter.phone %>"><%= coverLetter.phone %></a>
        </div>
        <div class="contact-item">
          <span class="icon-dot"></span>
          <span><%= coverLetter.address %></span>
        </div>
      </div>
      <div class="date-line"><%= coverLetter.date %></div>
      <div class="dear-line"><%= coverLetter.dear %></div>
      <% var paragraphs = coverLetter.textArea.split('\n').filter(function(p) { return p.trim() !== ''; }); %>
      <% paragraphs.forEach(function(p) { %>
        <p><%= p %></p>
      <% }); %>
      <% if (coverLetter.socialLinks && coverLetter.socialLinks.length) { %>
        <div class="social-strip">
          <% coverLetter.socialLinks.forEach(function(link) { %>
            <a href="<%= link.url %>" target="_blank"><%= link.label || link.url %></a>
          <% }); %>
        </div>
      <% } %>
      <div class="signature">
        <div class="signature-line"></div>
        <%= coverLetter.name %>
      </div>
    </div>
  </div>
</body>
</html>