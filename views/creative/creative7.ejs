<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@200;300;400;500;600;700&family=Prata&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Archivo', sans-serif;
      background: #fafafa;
      color: #1c1917;
      display: flex;
      justify-content: center;
      padding: 40px 20px;
    }
    .letter-wrapper {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #fff;
      padding: 48px 56px;
      position: relative;
      box-shadow: 0 20px 60px rgba(0,0,0,0.04);
    }
    .geo-border {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      pointer-events: none;
    }
    .geo-border svg {
      width: 100%;
      height: auto;
      display: block;
    }
    .geo-border-bottom {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      pointer-events: none;
      transform: rotate(180deg);
    }
    .geo-border-bottom svg {
      width: 100%;
      height: auto;
      display: block;
    }
    .header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 36px;
      position: relative;
      z-index: 1;
    }
    .header-left {
      flex: 1;
    }
    .header-name {
      font-family: 'Prata', serif;
      font-size: 36px;
      color: #1c1917;
      line-height: 1.2;
    }
    .header-title {
      font-size: 12px;
      color: #be123c;
      text-transform: uppercase;
      letter-spacing: 3px;
      font-weight: 500;
      margin-top: 6px;
    }
    .header-right {
      text-align: right;
      font-size: 13px;
      color: #78716c;
      line-height: 2;
      font-weight: 300;
    }
    .header-right a {
      color: #78716c;
      text-decoration: none;
      transition: color 0.2s;
    }
    .header-right a:hover { color: #0284c7; }
    .divider-geo {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 28px;
    }
    .divider-geo .line {
      flex: 1;
      height: 1px;
      background: #e7e5e4;
    }
    .divider-geo .diamond {
      width: 8px;
      height: 8px;
      background: #be123c;
      transform: rotate(45deg);
      flex-shrink: 0;
    }
    .date-line {
      font-size: 14px;
      color: #a8a29e;
      margin-bottom: 4px;
      font-weight: 300;
    }
    .dear-line {
      font-family: 'Prata', serif;
      font-size: 20px;
      color: #0284c7;
      margin-bottom: 20px;
    }
    .body-content p {
      margin-bottom: 18px;
      font-size: 15px;
      color: #44403c;
      font-weight: 300;
      line-height: 1.8;
    }
    .body-content p:first-of-type {
      border-left: 3px solid #be123c;
      padding-left: 18px;
    }
    .geo-social {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid #e7e5e4;
    }
    .geo-social a {
      font-size: 12px;
      color: #78716c;
      text-decoration: none;
      padding: 6px 18px;
      border: 1px solid #e7e5e4;
      transition: all 0.25s;
      letter-spacing: 0.3px;
    }
    .geo-social a:hover {
      border-color: #0284c7;
      color: #0284c7;
      background: #f0f9ff;
    }
    .signature-area {
      margin-top: 36px;
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .sig-diamond {
      width: 12px;
      height: 12px;
      background: #0284c7;
      transform: rotate(45deg);
      flex-shrink: 0;
    }
    .sig-name {
      font-family: 'Prata', serif;
      font-size: 22px;
      color: #1c1917;
    }
    @media (max-width: 768px) {
      .letter-wrapper { padding: 32px 24px; }
      .header-row { flex-direction: column; gap: 12px; }
      .header-right { text-align: left; }
      .geo-border, .geo-border-bottom { display: none; }
    }
@page { size: A4; margin: 12mm; }
    @media print {
      body { padding: 0; background: #fff; }
      .letter-wrapper { box-shadow: none; }
    }
  </style>
</head>
<body>
  <div class="letter-wrapper">
    <div class="geo-border">
      <svg viewBox="0 0 860 12" preserveAspectRatio="none">
        <polygon points="0,0 30,12 60,0 90,12 120,0 150,12 180,0 210,12 240,0 270,12 300,0 330,12 360,0 390,12 420,0 450,12 480,0 510,12 540,0 570,12 600,0 630,12 660,0 690,12 720,0 750,12 780,0 810,12 840,0 860,6" fill="none" stroke="#0284c7" stroke-width="1.5"/>
        <polygon points="0,6 30,0 60,6 90,0 120,6 150,0 180,6 210,0 240,6 270,0 300,6 330,0 360,6 390,0 420,6 450,0 480,6 510,0 540,6 570,0 600,6 630,0 660,6 690,0 720,6 750,0 780,6 810,0 840,6 860,0" fill="none" stroke="#be123c" stroke-width="0.8" opacity="0.5"/>
      </svg>
    </div>

    <div class="header-row">
      <div class="header-left">
        <div class="header-name"><%= coverLetter.name %></div>
        <div class="header-title">Cover Letter</div>
      </div>
      <div class="header-right">
        <div><a href="mailto:<%= coverLetter.email %>"><%= coverLetter.email %></a></div>
        <div><a href="tel:<%= coverLetter.phone %>"><%= coverLetter.phone %></a></div>
        <div><%= coverLetter.address %></div>
      </div>
    </div>

    <div class="divider-geo">
      <span class="line"></span>
      <span class="diamond"></span>
      <span class="line"></span>
    </div>

    <div class="date-line"><%= coverLetter.date %></div>
    <div class="dear-line"><%= coverLetter.dear %></div>

    <div class="body-content">
      <% var paragraphs = coverLetter.textArea.split('\n').filter(function(p) { return p.trim() !== ''; }); %>
      <% paragraphs.forEach(function(p) { %>
        <p><%= p %></p>
      <% }); %>
    </div>

    <% if (coverLetter.socialLinks && coverLetter.socialLinks.length) { %>
      <div class="geo-social">
        <% coverLetter.socialLinks.forEach(function(link) { %>
          <a href="<%= link.url %>" target="_blank"><%= link.label || link.url %></a>
        <% }); %>
      </div>
    <% } %>

    <div class="signature-area">
      <div class="sig-diamond"></div>
      <div class="sig-name"><%= coverLetter.name %></div>
    </div>

    <div class="geo-border-bottom">
      <svg viewBox="0 0 860 12" preserveAspectRatio="none">
        <polygon points="0,0 30,12 60,0 90,12 120,0 150,12 180,0 210,12 240,0 270,12 300,0 330,12 360,0 390,12 420,0 450,12 480,0 510,12 540,0 570,12 600,0 630,12 660,0 690,12 720,0 750,12 780,0 810,12 840,0 860,6" fill="none" stroke="#0284c7" stroke-width="1.5"/>
        <polygon points="0,6 30,0 60,6 90,0 120,6 150,0 180,6 210,0 240,6 270,0 300,6 330,0 360,6 390,0 420,6 450,0 480,6 510,0 540,6 570,0 600,6 630,0 660,6 690,0 720,6 750,0 780,6 810,0 840,6 860,0" fill="none" stroke="#be123c" stroke-width="0.8" opacity="0.5"/>
      </svg>
    </div>
  </div>
</body>
</html>