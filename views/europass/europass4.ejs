<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { display: flex; justify-content: center; background: #f2f0eb; font-family: 'Inter', sans-serif; font-weight: 400; color: #1a1a1a; line-height: 1.65; padding: 40px 20px; }
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; background: #fefefe; box-shadow: 0 4px 28px rgba(0,0,0,0.12); padding: 45px 55px; position: relative; }
    .side-accent { position: absolute; top: 0; right: 0; width: 40px; height: 100%; background: #111; }
    .side-accent::before { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: #d4a017; }
    .header { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 28px; border-bottom: 3px solid #111; margin-bottom: 5px; }
    .header-left { flex: 1; }
    .header-left h1 { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 28px; color: #111; letter-spacing: 0.5px; }
    .header-left h1 span { color: #d4a017; }
    .header-left .subhead { font-size: 10px; text-transform: uppercase; letter-spacing: 5px; color: #d4a017; font-weight: 600; margin-top: 4px; }
    .header-right { text-align: right; font-size: 12.5px; color: #333; }
    .header-right p { margin-bottom: 3px; }
    .header-right .label { font-weight: 700; color: #111; font-size: 9px; text-transform: uppercase; letter-spacing: 2px; display: block; }
    .header-right a { color: #333; text-decoration: none; }
    .header-right a:hover { color: #d4a017; }
    .divider { height: 1px; background: #ccc; margin: 4px 0; }
    .social-links { margin-top: 5px; font-size: 11px; }
    .social-links a { color: #111; text-decoration: none; display: inline-block; margin: 1px 0; }
    .social-links a:hover { color: #d4a017; }
    .date-line { text-align: left; margin: 22px 0 18px; font-size: 13px; color: #666; text-transform: uppercase; letter-spacing: 1px; }
    .dear { font-size: 15px; margin-bottom: 20px; font-weight: 400; }
    .content p { margin-bottom: 14px; text-align: justify; font-size: 13.5px; }
    .content p:first-of-type::first-letter { font-family: 'Playfair Display', serif; font-size: 36px; font-weight: 700; color: #d4a017; float: left; line-height: 1; margin-right: 8px; margin-top: 2px; }
    .signature { margin-top: 40px; padding-top: 25px; border-top: 2px solid #111; }
    .signature p { font-size: 13px; margin-bottom: 3px; }
    .signature .name { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 18px; color: #111; }
    .signature .title { font-size: 12px; color: #d4a017; font-weight: 600; }
    .bottom-stripe { margin-top: 25px; height: 3px; background: #111; position: relative; }
    .bottom-stripe::after { content: ''; position: absolute; top: 0; left: 0; width: 80px; height: 100%; background: #d4a017; }
    @page { size: A4; margin: 12mm; }
    @media print { body { background: #fff; padding: 0; } .page { max-width: 100%; box-shadow: none; padding: 20px 30px; } }
  </style>
</head>
<body>
  <div class="page">
    <div class="side-accent"></div>

    <div class="header">
      <div class="header-left">
        <h1><%= coverLetter.name %></h1>
        <div class="subhead">Anschreiben</div>
      </div>
      <div class="header-right">
        <p><span class="label">Adresse</span><%= coverLetter.address %></p>
        <div class="divider"></div>
        <p><span class="label">Email</span><a href="mailto:<%= coverLetter.email %>"><%= coverLetter.email %></a></p>
        <div class="divider"></div>
        <p><span class="label">Telefon</span><%= coverLetter.phone %></p>
        <% if (coverLetter.socialLinks && coverLetter.socialLinks.length) { %>
          <div class="social-links">
            <span class="label">Online</span>
            <% coverLetter.socialLinks.forEach(function(link) { %>
              <a href="<%= link %>" target="_blank"><%= link %></a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <div class="date-line"><%= coverLetter.date %></div>

    <div class="dear"><%= coverLetter.dear %>,</div>

    <div class="content">
      <% var paragraphs = coverLetter.textArea.split('\n').filter(function(p) { return p.trim() !== ''; }); %>
      <% paragraphs.forEach(function(p) { %>
        <p><%= p %></p>
      <% }); %>
    </div>

    <div class="signature">
      <p>Mit freundlichen Grüßen,</p>
      <div class="name"><%= coverLetter.name %></div>
      <div class="title">Bewerber</div>
    </div>

    <div class="bottom-stripe"></div>
  </div>
</body>
</html>
