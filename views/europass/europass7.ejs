<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Open+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { display: flex; justify-content: center; background: #f4f0ea; font-family: 'Open Sans', sans-serif; font-weight: 400; color: #222; line-height: 1.65; padding: 40px 20px; }
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; background: #fff; box-shadow: 0 4px 24px rgba(0,0,0,0.1); padding: 45px 55px; position: relative; }
    .border-frame { position: absolute; top: 10px; left: 10px; right: 10px; bottom: 10px; border: 1px solid #e67e22; pointer-events: none; }
    .header { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 25px; border-bottom: 3px solid #1a237e; }
    .header-left h1 { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 28px; color: #1a237e; }
    .header-left .subhead { font-size: 11px; text-transform: uppercase; letter-spacing: 4px; color: #e67e22; font-weight: 600; margin-top: 3px; }
    .header-right { text-align: right; font-size: 13px; color: #444; }
    .header-right p { margin-bottom: 4px; }
    .header-right .label { font-weight: 700; color: #1a237e; font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; display: block; }
    .header-right a { color: #444; text-decoration: none; }
    .header-right a:hover { color: #e67e22; }
    .divider { height: 1px; background: #ddd; margin: 4px 0; }
    .social-links { margin-top: 5px; font-size: 12px; }
    .social-links a { color: #e67e22; text-decoration: none; display: inline-block; margin: 1px 0; font-weight: 600; font-size: 11px; }
    .social-links a:hover { text-decoration: underline; }
    .date-line { text-align: left; margin: 22px 0 15px; font-size: 14px; color: #666; position: relative; padding-left: 15px; }
    .date-line::before { content: ''; position: absolute; left: 0; top: 50%; width: 8px; height: 8px; background: #e67e22; border-radius: 50%; transform: translateY(-50%); }
    .dear { font-size: 15px; margin-bottom: 20px; font-weight: 600; color: #1a237e; }
    .content p { margin-bottom: 14px; text-align: justify; font-size: 13.5px; }
    .content p:first-of-type { padding-left: 15px; border-left: 2px solid #e67e22; }
    .signature { margin-top: 40px; padding: 25px 0 0; display: flex; align-items: flex-end; justify-content: space-between; }
    .signature p { font-size: 13px; margin-bottom: 3px; color: #555; }
    .signature .name { font-family: 'Playfair Display', serif; font-weight: 600; font-size: 18px; color: #1a237e; }
    .signature .title { font-size: 12px; color: #e67e22; font-weight: 600; }
    .sig-icon { font-size: 30px; color: #e67e22; opacity: 0.5; line-height: 1; }
    @page { size: A4; margin: 12mm; }
    @media print { body { background: #fff; padding: 0; } .page { max-width: 100%; box-shadow: none; padding: 20px 30px; } }
  </style>
</head>
<body>
  <div class="page">
    <div class="border-frame"></div>

    <div class="header">
      <div class="header-left">
        <h1><%= coverLetter.name %></h1>
        <div class="subhead">Motivatiebrief</div>
      </div>
      <div class="header-right">
        <p><span class="label">Adres</span><%= coverLetter.address %></p>
        <div class="divider"></div>
        <p><span class="label">Email</span><a href="mailto:<%= coverLetter.email %>"><%= coverLetter.email %></a></p>
        <div class="divider"></div>
        <p><span class="label">Telefoon</span><%= coverLetter.phone %></p>
        <% if (coverLetter.socialLinks && coverLetter.socialLinks.length) { %>
          <div class="social-links">
            <span class="label">Profielen</span>
            <% coverLetter.socialLinks.forEach(function(link) { %>
              <a href="<%= link %>" target="_blank"><%= link %></a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <div class="date-line"><%= coverLetter.date %></div>

    <div class="dear"><%= coverLetter.dear %>,</div>

    <div class="content">
      <% var paragraphs = coverLetter.textArea.split('\n').filter(function(p) { return p.trim() !== ''; }); %>
      <% paragraphs.forEach(function(p) { %>
        <p><%= p %></p>
      <% }); %>
    </div>

    <div class="signature">
      <div>
        <p>Hoogachtend,</p>
        <div class="name"><%= coverLetter.name %></div>
        <div class="title">Sollicitant</div>
      </div>
      <div class="sig-icon">&#9998;</div>
    </div>
  </div>
</body>
</html>
