<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { display: flex; justify-content: center; background: #e8e4db; font-family: 'IBM Plex Sans', sans-serif; font-weight: 400; color: #222; line-height: 1.65; padding: 40px 20px; }
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; background: #fcfbf9; box-shadow: 0 6px 28px rgba(0,0,0,0.1); padding: 50px 55px; position: relative; }
    .header-band { position: absolute; top: 0; left: 0; right: 0; height: 55px; background: #006d77; display: flex; align-items: center; padding: 0 55px; }
    .header-band .monogram { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 22px; color: #fff; letter-spacing: 4px; }
    .header { display: flex; justify-content: space-between; align-items: flex-start; margin-top: 30px; padding: 20px 0 25px; }
    .header-left { flex: 1; }
    .header-left h1 { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 28px; color: #006d77; }
    .header-left .subhead { font-size: 11px; text-transform: uppercase; letter-spacing: 4px; color: #b8a99a; font-weight: 500; margin-top: 3px; }
    .header-right { text-align: right; font-size: 13px; color: #444; }
    .header-right p { margin-bottom: 4px; }
    .header-right .label { font-weight: 600; color: #006d77; font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; }
    .header-right a { color: #444; text-decoration: none; }
    .header-right a:hover { color: #006d77; }
    .divider { height: 1px; background: #ddd6cc; margin: 4px 0; }
    .social-links { margin-top: 6px; font-size: 12px; }
    .social-links a { color: #006d77; text-decoration: none; display: inline-block; margin: 1px 0; font-size: 11px; }
    .social-links a:hover { text-decoration: underline; }
    .date-line { text-align: right; margin: 20px 0 18px; font-size: 13px; color: #888; }
    .dear { font-size: 15px; margin-bottom: 20px; color: #333; }
    .content p { margin-bottom: 14px; text-align: justify; font-size: 13.5px; }
    .content p:first-of-type { padding-top: 8px; border-top: 1px solid #006d77; }
    .signature { margin-top: 40px; padding-top: 25px; display: flex; justify-content: space-between; align-items: flex-end; }
    .signature-left p { font-size: 13px; margin-bottom: 3px; }
    .signature-left .name { font-family: 'Playfair Display', serif; font-weight: 600; font-size: 18px; color: #006d77; }
    .signature-left .title { font-size: 12px; color: #b8a99a; }
    .signature-right { width: 120px; height: 50px; border: 1px solid #006d77; display: flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; font-size: 12px; color: #006d77; text-transform: uppercase; letter-spacing: 2px; opacity: 0.6; }
    .bottom-border { margin-top: 25px; height: 3px; background: linear-gradient(90deg, #006d77, #83c5be, #e8e4db); border-radius: 2px; }
    @page { size: A4; margin: 12mm; }
    @media print { body { background: #fff; padding: 0; } .page { max-width: 100%; box-shadow: none; padding: 20px 30px; } }
  </style>
</head>
<body>
  <div class="page">
    <div class="header-band">
      <div class="monogram"><%= coverLetter.name.charAt(0) %></div>
    </div>

    <div class="header">
      <div class="header-left">
        <h1><%= coverLetter.name %></h1>
        <div class="subhead">Cover Letter</div>
      </div>
      <div class="header-right">
        <p><span class="label">Address</span><br><%= coverLetter.address %></p>
        <div class="divider"></div>
        <p><span class="label">Email</span><br><a href="mailto:<%= coverLetter.email %>"><%= coverLetter.email %></a></p>
        <div class="divider"></div>
        <p><span class="label">Phone</span><br><%= coverLetter.phone %></p>
        <% if (coverLetter.socialLinks && coverLetter.socialLinks.length) { %>
          <div class="social-links">
            <span class="label">Online</span><br>
            <% coverLetter.socialLinks.forEach(function(link) { %>
              <a href="<%= link %>" target="_blank"><%= link %></a><br>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <div class="date-line"><%= coverLetter.date %></div>

    <div class="dear"><%= coverLetter.dear %>,</div>

    <div class="content">
      <% var paragraphs = coverLetter.textArea.split('\n').filter(function(p) { return p.trim() !== ''; }); %>
      <% paragraphs.forEach(function(p) { %>
        <p><%= p %></p>
      <% }); %>
    </div>

    <div class="signature">
      <div class="signature-left">
        <p>Yours sincerely,</p>
        <div class="name"><%= coverLetter.name %></div>
        <div class="title">Applicant</div>
      </div>
      <div class="signature-right">Seal</div>
    </div>

    <div class="bottom-border"></div>
  </div>
</body>
</html>
