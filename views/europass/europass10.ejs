<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Merriweather:wght@300;400;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { display: flex; justify-content: center; background: #f2ede4; font-family: 'Merriweather', serif; font-weight: 400; color: #2c2c2c; line-height: 1.7; padding: 40px 20px; }
    .page { width: 210mm; min-height: 297mm; margin: 0 auto; background: #fefcf8; box-shadow: 0 6px 30px rgba(0,0,0,0.1); padding: 50px 55px; position: relative; }
    .leaf-border { position: absolute; top: 0; left: 0; right: 0; height: 5px; background: linear-gradient(90deg, #2e7d32, #81c784, #2e7d32); }
    .leaf-border::before { content: ''; position: absolute; bottom: -8px; left: 50%; transform: translateX(-50%); width: 16px; height: 16px; background: #fefcf8; border-left: 3px solid #2e7d32; border-bottom: 3px solid #2e7d32; transform: translateX(-50%) rotate(-45deg); }
    .header { display: flex; justify-content: space-between; align-items: flex-start; padding-top: 8px; padding-bottom: 28px; border-bottom: 1px solid #d4cfc4; }
    .header-left { flex: 1; }
    .header-left h1 { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 28px; color: #2e7d32; }
    .header-left .subhead { font-size: 11px; text-transform: uppercase; letter-spacing: 4px; color: #b8a88a; font-weight: 300; margin-top: 3px; }
    .header-right { text-align: right; font-size: 12.5px; color: #555; }
    .header-right p { margin-bottom: 4px; }
    .header-right .label { font-weight: 700; color: #2e7d32; font-size: 9px; text-transform: uppercase; letter-spacing: 2px; display: block; }
    .header-right a { color: #555; text-decoration: none; }
    .header-right a:hover { color: #2e7d32; }
    .divider { height: 1px; background: #d4cfc4; margin: 4px 0; }
    .social-links { margin-top: 5px; font-size: 11px; }
    .social-links a { color: #2e7d32; text-decoration: none; display: inline-block; margin: 1px 0; }
    .social-links a:hover { text-decoration: underline; }
    .date-location { display: flex; justify-content: space-between; align-items: center; margin: 22px 0 18px; font-size: 13px; color: #888; font-style: italic; }
    .dear { font-size: 15px; margin-bottom: 20px; color: #2e7d32; font-weight: 400; }
    .content p { margin-bottom: 14px; text-align: justify; font-size: 13.5px; }
    .content strong { color: #2e7d32; }
    .signature { margin-top: 40px; padding-top: 25px; border-top: 2px solid #2e7d32; text-align: center; }
    .signature p { font-size: 13px; margin-bottom: 3px; color: #666; }
    .signature .name { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 18px; color: #2e7d32; letter-spacing: 1px; }
    .signature .title { font-size: 11px; color: #b8a88a; text-transform: uppercase; letter-spacing: 3px; margin-top: 4px; }
    .leaf-deco { text-align: center; margin-top: 18px; color: #81c784; font-size: 18px; letter-spacing: 8px; }
    @page { size: A4; margin: 12mm; }
    @media print { body { background: #fff; padding: 0; } .page { max-width: 100%; box-shadow: none; padding: 20px 30px; } }
  </style>
</head>
<body>
  <div class="page">
    <div class="leaf-border"></div>

    <div class="header">
      <div class="header-left">
        <h1><%= coverLetter.name %></h1>
        <div class="subhead">Cover Letter</div>
      </div>
      <div class="header-right">
        <p><span class="label">Address</span><%= coverLetter.address %></p>
        <div class="divider"></div>
        <p><span class="label">Email</span><a href="mailto:<%= coverLetter.email %>"><%= coverLetter.email %></a></p>
        <div class="divider"></div>
        <p><span class="label">Phone</span><%= coverLetter.phone %></p>
        <% if (coverLetter.socialLinks && coverLetter.socialLinks.length) { %>
          <div class="social-links">
            <span class="label">Online</span>
            <% coverLetter.socialLinks.forEach(function(link) { %>
              <a href="<%= link %>" target="_blank"><%= link %></a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <div class="date-location">
      <span></span>
      <span><%= coverLetter.date %></span>
    </div>

    <div class="dear"><%= coverLetter.dear %>,</div>

    <div class="content">
      <% var paragraphs = coverLetter.textArea.split('\n').filter(function(p) { return p.trim() !== ''; }); %>
      <% paragraphs.forEach(function(p) { %>
        <p><%= p %></p>
      <% }); %>
    </div>

    <div class="signature">
      <p>Yours faithfully,</p>
      <div class="name"><%= coverLetter.name %></div>
      <div class="title">Applicant</div>
    </div>

    <div class="leaf-deco">&#9670; &#9670; &#9670;</div>
  </div>
</body>
</html>
