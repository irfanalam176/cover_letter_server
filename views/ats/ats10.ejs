<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cover Letter</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #ecfeff;
      display: flex;
      justify-content: center;
      padding: 48px 24px;
      font-family: 'DM Sans', -apple-system, sans-serif;
      font-size: 10.5pt;
      line-height: 1.65;
      color: #1e293b;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #ffffff;
      padding: 48px 60px 48px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.04);
      border-radius: 3px;
      position: relative;
    }

    .page::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 60px;
      right: 60px;
      height: 3px;
      background: #155e75;
      opacity: 0.3;
      border-radius: 2px 2px 0 0;
    }

    .header {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 20px;
      margin-bottom: 6px;
    }

    .name {
      font-family: 'DM Serif Display', Georgia, serif;
      font-size: 23pt;
      font-weight: 400;
      color: #155e75;
      line-height: 1.1;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: auto auto;
      gap: 4px 16px;
      font-size: 8.5pt;
      color: #475569;
      align-content: start;
    }

    .contact-grid .label {
      color: #155e75;
      font-weight: 700;
      text-align: right;
      opacity: 0.7;
    }

    .contact-grid .value {
      text-align: left;
    }

    .sub-bar {
      height: 2px;
      background: #ccfbf1;
      margin: 14px 0 18px;
      border-radius: 1px;
    }

    .date-line {
      font-size: 9.5pt;
      margin-bottom: 14px;
      color: #334155;
    }

    .dear-line {
      font-size: 10.5pt;
      margin-bottom: 16px;
      font-weight: 500;
      color: #155e75;
    }

    .body-text p {
      margin-bottom: 13px;
    }

    .closing {
      margin-top: 28px;
    }

    .closing p {
      margin-bottom: 2px;
    }

    .signature {
      font-family: 'DM Serif Display', Georgia, serif;
      font-size: 14pt;
      font-style: italic;
      color: #155e75;
      margin-top: 6px;
      padding-top: 10px;
    }

    .sig-line {
      width: 120px;
      height: 1px;
      background: #155e75;
      opacity: 0.25;
      margin-bottom: 6px;
    }

    .social-links {
      margin-top: 10px;
      display: flex;
      gap: 14px;
      font-size: 9pt;
    }

    .social-links a {
      color: #155e75;
      text-decoration: none;
      font-weight: 500;
      padding: 2px 6px;
      background: #ecfeff;
      border-radius: 3px;
    }

    .social-links a:hover {
      background: #ccfbf1;
    }

@page { size: A4; margin: 12mm; }
    @media print {
      body { background: #fff; padding: 0; }
      .page { box-shadow: none; padding: 36px 52px; }
      .social-links a { background: none; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="header">
      <div class="name"><%= coverLetter.name %></div>
      <div class="contact-grid">
        <span class="label">Address</span>
        <span class="value"><%= coverLetter.address %></span>
        <span class="label">Email</span>
        <span class="value"><%= coverLetter.email %></span>
        <span class="label">Phone</span>
        <span class="value"><%= coverLetter.phone %></span>
        <% if (coverLetter.socialLinks) { %>
          <span class="label">Web</span>
          <span class="value"><%= coverLetter.socialLinks %></span>
        <% } %>
      </div>
    </div>

    <div class="sub-bar"></div>

    <div class="date-line"><%= coverLetter.date %></div>

    <div class="dear-line">Dear <%= coverLetter.dear %>,</div>

    <div class="body-text">
      <% (coverLetter.textArea || '').split('\n').filter(p => p.trim()).forEach(function(paragraph) { %>
        <p><%= paragraph %></p>
      <% }); %>
    </div>

    <div class="closing">
      <p>Sincerely,</p>
      <div class="sig-line"></div>
      <div class="signature"><%= coverLetter.name %></div>
    </div>
  </div>
</body>
</html>
