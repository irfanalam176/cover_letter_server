<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cover Letter</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #f0fdf4;
      display: flex;
      justify-content: center;
      padding: 48px 24px;
      font-family: 'Lato', -apple-system, sans-serif;
      font-size: 10.5pt;
      line-height: 1.65;
      color: #1e293b;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #ffffff;
      padding: 52px 60px 48px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.05);
      border-top: 6px double #166534;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid #dcfce7;
    }

    .header-left {
      flex: 1;
    }

    .name {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 24pt;
      font-weight: 700;
      color: #166534;
      letter-spacing: 0.02em;
      line-height: 1.2;
    }

    .header-right {
      text-align: right;
      font-size: 9pt;
      color: #475569;
      line-height: 1.8;
      padding-top: 4px;
    }

    .header-right span {
      display: block;
    }

    .diamond-divider {
      text-align: center;
      font-size: 10pt;
      color: #166534;
      letter-spacing: 8px;
      margin: 4px 0 18px;
      opacity: 0.5;
    }

    .date-line {
      font-size: 10pt;
      margin-bottom: 16px;
      color: #334155;
    }

    .dear-line {
      font-size: 11pt;
      margin-bottom: 14px;
      font-weight: 700;
      font-family: 'Cormorant Garamond', Georgia, serif;
      color: #166534;
    }

    .body-text p {
      margin-bottom: 13px;
      text-align: justify;
    }

    .body-text p:first-child::first-letter {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 22pt;
      font-weight: 700;
      color: #166534;
      float: left;
      line-height: 0.9;
      padding-right: 5px;
      margin-top: 2px;
    }

    .closing {
      margin-top: 28px;
    }

    .closing p {
      margin-bottom: 3px;
    }

    .signature {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 15pt;
      font-weight: 600;
      font-style: italic;
      color: #166534;
      margin-top: 8px;
      padding-top: 10px;
      border-top: 1px solid #bbf7d0;
    }

    .social-links {
      margin-top: 10px;
      display: flex;
      gap: 14px;
      font-size: 9pt;
      justify-content: flex-end;
    }

    .social-links a {
      color: #166534;
      text-decoration: none;
      font-weight: 500;
    }

    .social-links a:hover {
      text-decoration: underline;
    }

@page { size: A4; margin: 12mm; }
    @media print {
      body { background: #fff; padding: 0; }
      .page { box-shadow: none; border-top-color: #166534; padding: 36px 52px; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="header">
      <div class="header-left">
        <div class="name"><%= coverLetter.name %></div>
      </div>
      <div class="header-right">
        <span><%= coverLetter.address %></span>
        <span><%= coverLetter.email %></span>
        <span><%= coverLetter.phone %></span>
        <% if (coverLetter.socialLinks) { %>
          <span><%= coverLetter.socialLinks %></span>
        <% } %>
      </div>
    </div>

    <div class="diamond-divider">&diams; &diams; &diams;</div>

    <div class="date-line"><%= coverLetter.date %></div>

    <div class="dear-line">Dear <%= coverLetter.dear %>,</div>

    <div class="body-text">
      <% (coverLetter.textArea || '').split('\n').filter(p => p.trim()).forEach(function(paragraph) { %>
        <p><%= paragraph %></p>
      <% }); %>
    </div>

    <div class="closing">
      <p>Sincerely,</p>
      <div class="signature"><%= coverLetter.name %></div>
    </div>
  </div>
</body>
</html>
