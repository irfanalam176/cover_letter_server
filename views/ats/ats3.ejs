<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cover Letter</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #f8fafc;
      display: flex;
      justify-content: center;
      padding: 48px 24px;
      font-family: 'Roboto', -apple-system, sans-serif;
      font-size: 10pt;
      line-height: 1.7;
      color: #1e293b;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #ffffff;
      padding: 48px 56px 48px 64px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.05);
      border-left: 5px solid #475569;
      position: relative;
    }

    .page::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 5px;
      background: linear-gradient(to bottom, #475569, #94a3b8);
    }

    .header {
      margin-bottom: 24px;
    }

    .name {
      font-family: 'Merriweather', Georgia, serif;
      font-size: 20pt;
      font-weight: 900;
      color: #475569;
      letter-spacing: 0.01em;
      margin-bottom: 2px;
    }

    .title-line {
      font-family: 'Merriweather', Georgia, serif;
      font-size: 9pt;
      font-style: italic;
      color: #64748b;
      margin-bottom: 8px;
    }

    .contact-block {
      font-size: 9pt;
      color: #475569;
      line-height: 1.8;
    }

    .contact-block span {
      display: block;
    }

    .divider {
      border: none;
      height: 1px;
      background: #cbd5e1;
      margin: 18px 0 20px;
    }

    .date-line {
      font-size: 10pt;
      margin-bottom: 16px;
      color: #475569;
    }

    .dear-line {
      font-size: 10.5pt;
      margin-bottom: 16px;
      font-weight: 700;
      color: #475569;
    }

    .body-text p {
      margin-bottom: 14px;
      text-align: justify;
    }

    .closing {
      margin-top: 28px;
    }

    .closing p {
      margin-bottom: 4px;
    }

    .signature {
      font-family: 'Merriweather', Georgia, serif;
      font-size: 13pt;
      font-weight: 700;
      color: #475569;
      margin-top: 10px;
    }

    .social-links {
      margin-top: 10px;
      display: flex;
      gap: 14px;
      font-size: 9pt;
    }

    .social-links a {
      color: #475569;
      text-decoration: none;
      font-weight: 500;
    }

    .social-links a:hover {
      text-decoration: underline;
    }

@page { size: A4; margin: 12mm; }
    @media print {
      body { background: #fff; padding: 0; }
      .page { box-shadow: none; padding: 36px 48px 36px 56px; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="header">
      <div class="name"><%= coverLetter.name %></div>
      <div class="title-line">Professional Cover Letter</div>
      <div class="contact-block">
        <span><%= coverLetter.address %></span>
        <span><%= coverLetter.email %> &middot; <%= coverLetter.phone %></span>
        <% if (coverLetter.socialLinks) { %>
          <span><%= coverLetter.socialLinks %></span>
        <% } %>
      </div>
    </div>

    <hr class="divider" />

    <div class="date-line"><%= coverLetter.date %></div>

    <div class="dear-line">Dear <%= coverLetter.dear %>,</div>

    <div class="body-text">
      <% (coverLetter.textArea || '').split('\n').filter(p => p.trim()).forEach(function(paragraph) { %>
        <p><%= paragraph %></p>
      <% }); %>
    </div>

    <div class="closing">
      <p>Sincerely,</p>
      <div class="signature"><%= coverLetter.name %></div>
    </div>
  </div>
</body>
</html>
