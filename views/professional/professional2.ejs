<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      display: flex;
      justify-content: center;
      background: #1a1a1a;
      font-family: 'Montserrat', 'Helvetica Neue', sans-serif;
      font-size: 10.5pt;
      line-height: 1.7;
      color: #2d3436;
      padding: 40px 20px;
    }
    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #fff;
      padding: 55px 60px 50px;
      box-shadow: 0 8px 40px rgba(0,0,0,0.2);
      position: relative;
    }
    .page::before {
      content: '';
      position: absolute;
      top: 0; left: 60px; right: 60px;
      height: 1px;
      background: #2d3436;
    }
    .page::after {
      content: '';
      position: absolute;
      top: 4px; left: 60px; right: 60px;
      height: 1px;
      background: #2d3436;
    }
    .letterhead {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding-bottom: 24px;
      border-bottom: 3px solid #2d3436;
      margin-bottom: 30px;
    }
    .letterhead-left h1 {
      font-family: 'Playfair Display', serif;
      font-size: 26pt;
      font-weight: 600;
      color: #2d3436;
      letter-spacing: 1px;
      line-height: 1.1;
    }
    .letterhead-left .desig {
      font-size: 8.5pt;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: #888;
      margin-top: 4px;
      font-weight: 300;
    }
    .letterhead-right {
      text-align: right;
      font-size: 8.5pt;
      color: #666;
      line-height: 1.8;
      font-weight: 300;
    }
    .letterhead-right a {
      color: #2d3436;
      text-decoration: none;
    }
    .date-line {
      text-align: left;
      margin-bottom: 20px;
      font-size: 10pt;
      color: #888;
      font-weight: 300;
    }
    .dear {
      font-size: 11pt;
      margin-bottom: 16px;
      color: #2d3436;
      font-weight: 600;
    }
    .body-text p {
      margin-bottom: 14px;
      text-align: justify;
      color: #444;
    }
    .signature-block {
      margin-top: 32px;
      display: flex;
      align-items: flex-end;
      gap: 20px;
    }
    .signature-line {
      flex: 1;
      max-width: 220px;
      border-top: 2px solid #2d3436;
      margin-bottom: 8px;
    }
    .signature-details {
      flex: 1;
    }
    .signature-name {
      font-family: 'Playfair Display', serif;
      font-size: 16pt;
      font-weight: 600;
      color: #2d3436;
    }
    .signature-title {
      font-size: 9pt;
      color: #888;
      font-weight: 300;
      letter-spacing: 1px;
      margin-top: 2px;
    }
    .social-links {
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1px solid #eee;
      font-size: 8.5pt;
      color: #aaa;
      font-weight: 300;
    }
    .social-links a {
      color: #2d3436;
      text-decoration: none;
      margin-right: 14px;
    }
    .footer-note {
      margin-top: 30px;
      text-align: center;
      font-size: 7.5pt;
      color: #ccc;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    @page { size: A4; margin: 12mm; }
    @media print {
      body { background: #fff; padding: 0; }
      .page { max-width: 100%; box-shadow: none; padding: 40px 50px; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="letterhead">
      <div class="letterhead-left">
        <h1><%= coverLetter.name %></h1>
        <div class="desig">Executive Correspondence</div>
      </div>
      <div class="letterhead-right">
        <div><%= coverLetter.address %></div>
        <div><%= coverLetter.email %></div>
        <div><%= coverLetter.phone %></div>
        <% if (coverLetter.socialLinks) { %>
          <div><a href="<%= coverLetter.socialLinks %>"><%= coverLetter.socialLinks %></a></div>
        <% } %>
      </div>
    </div>
    <div class="date-line"><%= coverLetter.date %></div>
    <div class="dear"><%= coverLetter.dear %></div>
    <div class="body-text">
      <% coverLetter.textArea.split('\n').filter(p => p.trim()).forEach(function(paragraph) { %>
        <p><%= paragraph %></p>
      <% }); %>
    </div>
    <div class="signature-block">
      <div class="signature-details">
        <div class="signature-line"></div>
        <div class="signature-name"><%= coverLetter.name %></div>
        <div class="signature-title">Executive Leadership</div>
      </div>
    </div>
    <% if (coverLetter.socialLinks) { %>
      <div class="social-links">
        <strong>Online:</strong> <a href="<%= coverLetter.socialLinks %>"><%= coverLetter.socialLinks %></a>
      </div>
    <% } %>
    <div class="footer-note">&mdash; Confidential &mdash;</div>
  </div>
</body>
</html>
