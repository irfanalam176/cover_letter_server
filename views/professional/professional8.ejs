<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      display: flex;
      justify-content: center;
      background: #0f0f1a;
      font-family: 'Raleway', 'Helvetica Neue', sans-serif;
      font-size: 10.5pt;
      line-height: 1.7;
      color: #c8c8d0;
      padding: 40px 20px;
    }
    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #1a1a2e;
      padding: 50px 60px 50px;
      box-shadow: 0 8px 40px rgba(0,0,0,0.4);
      position: relative;
    }
    .page::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, #ffffff33, transparent);
    }
    .page::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, #ffffff22, transparent);
    }
    .letterhead {
      text-align: center;
      padding-bottom: 28px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      margin-bottom: 30px;
      position: relative;
    }
    .letterhead h1 {
      font-family: 'Cinzel', serif;
      font-size: 24pt;
      font-weight: 600;
      color: #ffffff;
      letter-spacing: 4px;
      text-transform: uppercase;
    }
    .letterhead .line-decor {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin: 12px 0 8px;
    }
    .letterhead .line-decor span {
      display: block;
      width: 40px;
      height: 1px;
      background: rgba(255,255,255,0.2);
    }
    .letterhead .line-decor i {
      color: rgba(255,255,255,0.3);
      font-size: 6pt;
    }
    .letterhead .sub {
      font-size: 8.5pt;
      color: rgba(255,255,255,0.4);
      letter-spacing: 5px;
      text-transform: uppercase;
      font-weight: 300;
    }
    .contact-line {
      display: flex;
      justify-content: center;
      gap: 0;
      flex-wrap: wrap;
      margin-top: 14px;
      font-size: 9pt;
      color: rgba(255,255,255,0.5);
      font-weight: 300;
    }
    .contact-line span {
      padding: 0 14px;
      border-right: 1px solid rgba(255,255,255,0.08);
    }
    .contact-line span:last-child { border-right: none; }
    .contact-line a {
      color: rgba(255,255,255,0.6);
      text-decoration: none;
    }
    .contact-line a:hover { color: #fff; }
    .date-line {
      text-align: right;
      margin-bottom: 22px;
      font-size: 10pt;
      color: rgba(255,255,255,0.3);
      font-family: 'Cinzel', serif;
      letter-spacing: 1px;
    }
    .dear {
      font-size: 11pt;
      margin-bottom: 16px;
      color: #ffffff;
      font-weight: 500;
      letter-spacing: 0.3px;
    }
    .body-text p {
      margin-bottom: 14px;
      text-align: justify;
      color: #b8b8c8;
    }
    .body-text p:first-of-type::first-letter {
      font-family: 'Cinzel', serif;
      font-size: 32pt;
      font-weight: 600;
      color: #ffffff;
      float: left;
      line-height: 0.9;
      margin-right: 6px;
      margin-top: 4px;
    }
    .signature-block {
      margin-top: 34px;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    .signature-line {
      width: 180px;
      border-top: 1px solid rgba(255,255,255,0.3);
      margin-bottom: 10px;
    }
    .signature-name {
      font-family: 'Cinzel', serif;
      font-size: 14pt;
      font-weight: 500;
      color: #ffffff;
      letter-spacing: 2px;
    }
    .signature-title {
      font-size: 8.5pt;
      color: rgba(255,255,255,0.4);
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-top: 4px;
      font-weight: 300;
    }
    .social-links {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid rgba(255,255,255,0.05);
      font-size: 9pt;
      color: rgba(255,255,255,0.3);
    }
    .social-links a {
      color: rgba(255,255,255,0.6);
      text-decoration: none;
      margin-right: 14px;
    }
    .social-links a:hover { color: #fff; }
    .motto {
      text-align: center;
      margin-top: 28px;
      font-size: 7pt;
      color: rgba(255,255,255,0.12);
      letter-spacing: 6px;
      text-transform: uppercase;
    }
    @page { size: A4; margin: 12mm; }
    @media print {
      body { background: #fff; padding: 0; }
      .page { max-width: 100%; box-shadow: none; padding: 20px 30px; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="letterhead">
      <h1><%= coverLetter.name %></h1>
      <div class="line-decor">
        <span></span><i>&#9670;</i><span></span>
      </div>
      <div class="sub">Executive Correspondence</div>
      <div class="contact-line">
        <span><%= coverLetter.address %></span>
        <span><%= coverLetter.email %></span>
        <span><%= coverLetter.phone %></span>
        <% if (coverLetter.socialLinks) { %>
          <span><a href="<%= coverLetter.socialLinks %>"><%= coverLetter.socialLinks %></a></span>
        <% } %>
      </div>
    </div>
    <div class="date-line"><%= coverLetter.date %></div>
    <div class="dear"><%= coverLetter.dear %></div>
    <div class="body-text">
      <% coverLetter.textArea.split('\n').filter(p => p.trim()).forEach(function(paragraph) { %>
        <p><%= paragraph %></p>
      <% }); %>
    </div>
    <div class="signature-block">
      <div class="signature-line"></div>
      <div class="signature-name"><%= coverLetter.name %></div>
      <div class="signature-title">Executive Leadership</div>
    </div>
    <% if (coverLetter.socialLinks) { %>
      <div class="social-links">
        <strong>Digital:</strong> <a href="<%= coverLetter.socialLinks %>"><%= coverLetter.socialLinks %></a>
      </div>
    <% } %>
    <div class="motto">Excellence Without Compromise</div>
  </div>
</body>
</html>
