<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Marcellus+SC&family=Open+Sans:wght@300;400;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      display: flex;
      justify-content: center;
      background: #1a1f2e;
      font-family: 'Open Sans', 'Helvetica Neue', sans-serif;
      font-size: 10.5pt;
      line-height: 1.7;
      color: #2d3748;
      padding: 40px 20px;
    }
    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #fafafc;
      padding: 50px 60px 50px;
      box-shadow: 0 8px 40px rgba(0,0,0,0.25);
      position: relative;
      border: 1px solid #e2e0e8;
    }
    .page::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 5px;
      background: linear-gradient(90deg, #4a5568, #c9a84c, #4a5568);
    }
    .letterhead {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 22px;
      border-bottom: 2px solid #e2e0e8;
      margin-bottom: 28px;
      position: relative;
    }
    .letterhead::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 80px;
      height: 3px;
      background: #c9a84c;
    }
    .lh-left h1 {
      font-family: 'Marcellus SC', serif;
      font-size: 22pt;
      font-weight: 400;
      color: #4a5568;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    .lh-left .title-tag {
      font-size: 8.5pt;
      color: #c9a84c;
      letter-spacing: 3px;
      text-transform: uppercase;
      font-weight: 600;
      margin-top: 5px;
    }
    .lh-right {
      text-align: right;
      font-size: 8.5pt;
      color: #718096;
      line-height: 2;
      font-weight: 300;
    }
    .lh-right a {
      color: #4a5568;
      text-decoration: none;
    }
    .date-line {
      text-align: left;
      margin-bottom: 20px;
      font-size: 10pt;
      color: #a0aec0;
      font-weight: 300;
    }
    .dear {
      font-size: 11pt;
      margin-bottom: 16px;
      color: #4a5568;
      font-weight: 600;
      letter-spacing: 0.3px;
    }
    .body-text p {
      margin-bottom: 14px;
      text-align: justify;
      color: #4a5568;
    }
    .body-text p:first-of-type::first-letter {
      font-family: 'Marcellus', serif;
      font-size: 36pt;
      font-weight: 400;
      color: #c9a84c;
      float: left;
      line-height: 0.9;
      margin-right: 6px;
      margin-top: 4px;
    }
    .signature-block {
      margin-top: 32px;
      padding-top: 18px;
      border-top: 2px solid #e2e0e8;
    }
    .signature-line {
      width: 200px;
      border-top: 2px solid #4a5568;
      margin-bottom: 8px;
    }
    .signature-name {
      font-family: 'Marcellus SC', serif;
      font-size: 15pt;
      color: #4a5568;
      letter-spacing: 1px;
    }
    .signature-title {
      font-size: 9pt;
      color: #c9a84c;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-top: 3px;
    }
    .social-links {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid #e8e6ee;
      font-size: 9pt;
      color: #a0aec0;
    }
    .social-links a {
      color: #4a5568;
      text-decoration: none;
      margin-right: 14px;
    }
    .gold-accent {
      position: absolute;
      bottom: 25px;
      right: 35px;
      font-size: 7.5pt;
      color: #c9a84c;
      letter-spacing: 5px;
      font-weight: 600;
      text-transform: uppercase;
    }
    @page { size: A4; margin: 12mm; }
    @media print {
      body { background: #fff; padding: 0; }
      .page { max-width: 100%; box-shadow: none; padding: 40px 50px; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="letterhead">
      <div class="lh-left">
        <h1><%= coverLetter.name %></h1>
        <div class="title-tag">Executive Profile</div>
      </div>
      <div class="lh-right">
        <div><%= coverLetter.address %></div>
        <div><%= coverLetter.email %></div>
        <div><%= coverLetter.phone %></div>
        <% if (coverLetter.socialLinks) { %>
          <div><a href="<%= coverLetter.socialLinks %>"><%= coverLetter.socialLinks %></a></div>
        <% } %>
      </div>
    </div>
    <div class="date-line"><%= coverLetter.date %></div>
    <div class="dear"><%= coverLetter.dear %></div>
    <div class="body-text">
      <% coverLetter.textArea.split('\n').filter(p => p.trim()).forEach(function(paragraph) { %>
        <p><%= paragraph %></p>
      <% }); %>
    </div>
    <div class="signature-block">
      <div class="signature-line"></div>
      <div class="signature-name"><%= coverLetter.name %></div>
      <div class="signature-title">Executive Leadership</div>
    </div>
    <% if (coverLetter.socialLinks) { %>
      <div class="social-links">
        <strong>Connect:</strong> <a href="<%= coverLetter.socialLinks %>"><%= coverLetter.socialLinks %></a>
      </div>
    <% } %>
    <div class="gold-accent">&diams; Platinum &diams;</div>
  </div>
</body>
</html>
