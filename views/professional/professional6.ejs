<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link href="https://fonts.googleapis.com/css2?family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      display: flex;
      justify-content: center;
      background: #e8e0d5;
      font-family: 'Jost', 'Helvetica Neue', sans-serif;
      font-size: 10.5pt;
      line-height: 1.7;
      color: #2a3a2a;
      padding: 40px 20px;
    }
    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #fcf9f5;
      padding: 50px 60px 50px;
      box-shadow: 0 4px 25px rgba(26,58,42,0.06);
      position: relative;
    }
    .page::before {
      content: '';
      position: absolute;
      top: 15px; left: 15px; right: 15px; bottom: 15px;
      border: 1px solid #c5b8a8;
      pointer-events: none;
    }
    .page-inner {
      position: relative;
      z-index: 1;
    }
    .letterhead {
      text-align: center;
      padding: 20px 0 24px;
      margin-bottom: 28px;
      position: relative;
    }
    .letterhead h1 {
      font-family: 'Old Standard TT', serif;
      font-size: 28pt;
      font-weight: 700;
      color: #1a3a2a;
      letter-spacing: 1px;
    }
    .letterhead .divider {
      width: 80px;
      height: 1px;
      background: #8a7a6a;
      margin: 12px auto;
    }
    .letterhead .sub {
      font-family: 'Old Standard TT', serif;
      font-style: italic;
      font-size: 10.5pt;
      color: #8a7a6a;
      letter-spacing: 2px;
    }
    .contact-strip {
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
      margin-top: 14px;
      font-size: 9pt;
      color: #6a7a5a;
      font-weight: 300;
    }
    .contact-strip a {
      color: #1a3a2a;
      text-decoration: none;
      font-weight: 400;
    }
    .contact-strip .dot {
      color: #b5aa9a;
    }
    .date-line {
      text-align: right;
      margin-bottom: 22px;
      font-size: 10pt;
      color: #8a7a6a;
      font-family: 'Old Standard TT', serif;
      font-style: italic;
    }
    .dear {
      font-size: 11pt;
      margin-bottom: 16px;
      color: #1a3a2a;
      font-weight: 500;
    }
    .body-text p {
      margin-bottom: 14px;
      text-align: justify;
      color: #3a4a3a;
    }
    .body-text p:first-of-type::first-letter {
      font-family: 'Old Standard TT', serif;
      font-size: 40pt;
      font-weight: 700;
      color: #1a3a2a;
      float: left;
      line-height: 0.85;
      margin-right: 6px;
      margin-top: 4px;
    }
    .signature-block {
      margin-top: 34px;
      padding-top: 16px;
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .signature-line {
      width: 180px;
      border-top: 2px solid #1a3a2a;
    }
    .signature-text {
      flex: 1;
    }
    .signature-name {
      font-family: 'Old Standard TT', serif;
      font-size: 17pt;
      font-weight: 700;
      color: #1a3a2a;
    }
    .signature-title {
      font-size: 9.5pt;
      color: #8a7a6a;
      letter-spacing: 1.5px;
      font-weight: 300;
    }
    .social-links {
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1px solid #ddd5c8;
      font-size: 9pt;
      color: #8a7a6a;
    }
    .social-links a {
      color: #1a3a2a;
      text-decoration: none;
      margin-right: 14px;
    }
    .footer-leaf {
      text-align: center;
      margin-top: 28px;
      font-size: 16pt;
      color: #c5b8a8;
      letter-spacing: 10px;
    }
    @page { size: A4; margin: 12mm; }
    @media print {
      body { background: #fff; padding: 0; }
      .page { max-width: 100%; box-shadow: none; padding: 30px 40px; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="page-inner">
      <div class="letterhead">
        <h1><%= coverLetter.name %></h1>
        <div class="divider"></div>
        <div class="sub">Executive Leadership &bull; Strategic Vision</div>
        <div class="contact-strip">
          <span><%= coverLetter.address %></span>
          <span class="dot">&#9679;</span>
          <span><%= coverLetter.email %></span>
          <span class="dot">&#9679;</span>
          <span><%= coverLetter.phone %></span>
          <% if (coverLetter.socialLinks) { %>
            <span class="dot">&#9679;</span>
            <span><a href="<%= coverLetter.socialLinks %>"><%= coverLetter.socialLinks %></a></span>
          <% } %>
        </div>
      </div>
      <div class="date-line"><%= coverLetter.date %></div>
      <div class="dear"><%= coverLetter.dear %></div>
      <div class="body-text">
        <% coverLetter.textArea.split('\n').filter(p => p.trim()).forEach(function(paragraph) { %>
          <p><%= paragraph %></p>
        <% }); %>
      </div>
      <div class="signature-block">
        <div class="signature-line"></div>
        <div class="signature-text">
          <div class="signature-name"><%= coverLetter.name %></div>
          <div class="signature-title">Executive Leadership</div>
        </div>
      </div>
      <% if (coverLetter.socialLinks) { %>
        <div class="social-links">
          <strong>Online:</strong> <a href="<%= coverLetter.socialLinks %>"><%= coverLetter.socialLinks %></a>
        </div>
      <% } %>
      <div class="footer-leaf">&#8766;</div>
    </div>
  </div>
</body>
</html>
