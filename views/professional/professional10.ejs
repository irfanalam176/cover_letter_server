<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cover Letter</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      display: flex;
      justify-content: center;
      background: #0a0e1a;
      font-family: 'Inter', 'Helvetica Neue', sans-serif;
      font-size: 10.5pt;
      line-height: 1.7;
      color: #b8c0d0;
      padding: 40px 20px;
    }
    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #0f172a;
      padding: 55px 65px 50px;
      box-shadow: 0 8px 50px rgba(0,0,0,0.5);
      position: relative;
      border: 1px solid rgba(255,255,255,0.06);
    }
    .page::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    }
    .page-inner {
      position: relative;
      z-index: 1;
    }
    .letterhead {
      padding-bottom: 28px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      margin-bottom: 30px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 30px;
    }
    .lh-primary h1 {
      font-family: 'Playfair Display', serif;
      font-size: 26pt;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: 1px;
      line-height: 1.15;
    }
    .lh-primary .epithet {
      font-size: 8.5pt;
      color: rgba(255,255,255,0.3);
      letter-spacing: 4px;
      text-transform: uppercase;
      font-weight: 300;
      margin-top: 6px;
    }
    .lh-secondary {
      text-align: right;
      font-size: 8.5pt;
      color: rgba(255,255,255,0.4);
      line-height: 2;
      font-weight: 300;
      flex-shrink: 0;
    }
    .lh-secondary a {
      color: rgba(255,255,255,0.5);
      text-decoration: none;
    }
    .lh-secondary a:hover { color: #fff; }
    .date-line {
      text-align: left;
      margin-bottom: 20px;
      font-size: 9.5pt;
      color: rgba(255,255,255,0.25);
      font-weight: 300;
      letter-spacing: 0.5px;
    }
    .dear {
      font-size: 11pt;
      margin-bottom: 16px;
      color: #ffffff;
      font-weight: 500;
      letter-spacing: 0.3px;
    }
    .body-text p {
      margin-bottom: 14px;
      text-align: justify;
      color: #b8c0d0;
    }
    .body-text p:first-of-type::first-letter {
      font-family: 'Playfair Display', serif;
      font-size: 36pt;
      font-weight: 700;
      color: #ffffff;
      float: left;
      line-height: 0.88;
      margin-right: 6px;
      margin-top: 4px;
      text-shadow: 0 0 30px rgba(255,255,255,0.06);
    }
    .signature-block {
      margin-top: 34px;
      padding-top: 22px;
      border-top: 1px solid rgba(255,255,255,0.06);
      display: flex;
      align-items: flex-end;
      gap: 24px;
    }
    .sig-left {
      flex: 0 0 auto;
    }
    .sig-line {
      width: 200px;
      border-top: 1px solid rgba(255,255,255,0.25);
      margin-bottom: 10px;
    }
    .sig-name {
      font-family: 'Playfair Display', serif;
      font-size: 16pt;
      font-weight: 600;
      color: #ffffff;
      letter-spacing: 0.5px;
    }
    .sig-title {
      font-size: 8.5pt;
      color: rgba(255,255,255,0.35);
      letter-spacing: 2.5px;
      text-transform: uppercase;
      font-weight: 400;
      margin-top: 4px;
    }
    .sig-seal {
      font-size: 28pt;
      color: rgba(255,255,255,0.06);
      font-family: 'Playfair Display', serif;
      line-height: 1;
    }
    .social-links {
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1px solid rgba(255,255,255,0.04);
      font-size: 9pt;
      color: rgba(255,255,255,0.25);
    }
    .social-links a {
      color: rgba(255,255,255,0.5);
      text-decoration: none;
      margin-right: 16px;
    }
    .social-links a:hover { color: #fff; }
    .pearl-line {
      position: absolute;
      bottom: 20px;
      left: 65px; right: 65px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
    }
    @page { size: A4; margin: 12mm; }
    @media print {
      body { background: #fff; padding: 0; }
      .page { max-width: 100%; box-shadow: none; border: none; padding: 20px 30px; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="page-inner">
      <div class="letterhead">
        <div class="lh-primary">
          <h1><%= coverLetter.name %></h1>
          <div class="epithet">Executive Leadership</div>
        </div>
        <div class="lh-secondary">
          <div><%= coverLetter.address %></div>
          <div><%= coverLetter.email %></div>
          <div><%= coverLetter.phone %></div>
          <% if (coverLetter.socialLinks) { %>
            <div><a href="<%= coverLetter.socialLinks %>"><%= coverLetter.socialLinks %></a></div>
          <% } %>
        </div>
      </div>
      <div class="date-line"><%= coverLetter.date %></div>
      <div class="dear"><%= coverLetter.dear %></div>
      <div class="body-text">
        <% coverLetter.textArea.split('\n').filter(p => p.trim()).forEach(function(paragraph) { %>
          <p><%= paragraph %></p>
        <% }); %>
      </div>
      <div class="signature-block">
        <div class="sig-left">
          <div class="sig-line"></div>
          <div class="sig-name"><%= coverLetter.name %></div>
          <div class="sig-title">Executive Leadership</div>
        </div>
        <div class="sig-seal">&#10070;</div>
      </div>
      <% if (coverLetter.socialLinks) { %>
        <div class="social-links">
          <strong>Connect:</strong> <a href="<%= coverLetter.socialLinks %>"><%= coverLetter.socialLinks %></a>
        </div>
      <% } %>
      <div class="pearl-line"></div>
    </div>
  </div>
</body>
</html>
